# Copy this file to .env for local development. Never commit a real .env.
# In production, set these in your host's environment variable settings
# (Render, Railway, Fly.io, etc.).

# API key from https://resend.com
RESEND_API_KEY=

# The portfolio owner's real inbox — this is where messages are delivered
CONTACT_TO_EMAIL=

# A sending address on a domain you've verified in Resend
# e.g. "Portfolio <contact@yourdomain.com>"
CONTACT_FROM=

# The deployed frontend's origin, so the API only accepts requests from it.
# Use * only for local testing — lock this down in production.
ALLOWED_ORIGIN=http://localhost:5500

# Port the server listens on (optional)
PORT=4000
